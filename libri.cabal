cabal-version:      3.0
name:               libri
version:            0.1.0.0
synopsis:           TUI/CLI tool for managing a physical book collection
description:        A terminal user interface for managing physical books,
                    with import from Calibre, ISBN lookup, fuzzy search,
                    and YAML-based storage.
license:            MIT
license-file:       LICENSE
author:             User
maintainer:         user@example.com
category:           Application
build-type:         Simple
extra-doc-files:    README.md

common warnings
    ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
                 -Wincomplete-uni-patterns -Wmissing-export-lists
                 -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints

library
    import:           warnings
    exposed-modules:  Libri.Types
                    , Libri.Storage.Yaml
                    , Libri.Storage.Index
                    , Libri.Storage.CalibreImport
                    , Libri.Storage.CalibreReconcile
                    , Libri.Storage.CalibreSync
                    , Libri.CLI.Commands
                    , Libri.CLI.BatchImport
                    , Libri.CLI.CalibreImport
                    , Libri.CLI.Doctor
                    , Libri.CLI.Enrich
                    , Libri.CLI.Migrate
                    , Libri.CLI.Tags
                    , Libri.Search.Fuzzy
                    , Libri.Text.Normalize
                    , Libri.ISBN.OpenLibrary
                    , Libri.TUI.App
                    , Libri.TUI.Views.BookList
                    , Libri.TUI.Views.BookDetails
                    , Libri.TUI.Views.AddBook
                    , Libri.TUI.Views.MoveBook
                    , Libri.TUI.Views.Search
                    , Libri.TUI.Widgets.Common
                    , Libri.TUI.CommandBar
                    , Libri.TUI.Views.GroupedList
                    , Libri.TUI.Views.TagSidebar
    build-depends:    base ^>=4.17 || ^>=4.18 || ^>=4.19 || ^>=4.20
                    , text >=2.0 && <3
                    , bytestring >=0.11 && <0.13
                    , containers >=0.6 && <0.8
                    , time >=1.12 && <2
                    , directory >=1.3 && <2
                    , filepath >=1.4 && <2
                    , yaml >=0.11 && <0.12
                    , aeson >=2.1 && <3
                    , brick >=2.1 && <3
                    , vty >=6.1 && <7
                    , vty-crossplatform >=0.4 && <1
                    , optparse-applicative >=0.18 && <0.19
                    , scientific >=0.3 && <0.4
                    , sqlite-simple >=0.4 && <0.5
                    , http-client >=0.7 && <0.8
                    , http-client-tls >=0.3 && <0.4
                    , http-types >=0.12 && <0.13
                    , vector >=0.13 && <0.14
                    , uuid >=1.3 && <2
                    , microlens >=0.4 && <0.5
                    , microlens-th >=0.4 && <0.5
                    , microlens-mtl >=0.2 && <0.3
                    , mtl >=2.2 && <3
                    , transformers >=0.5 && <0.7
                    , text-metrics >=0.3 && <0.4
                    , unicode-transforms >=0.4 && <0.5
                    , temporary >=1.3 && <2
                    , process >=1.6 && <2
    hs-source-dirs:   src
    default-language: GHC2021
    default-extensions: OverloadedStrings
                      , DeriveGeneric
                      , DeriveAnyClass
                      , RecordWildCards
                      , LambdaCase
                      , TupleSections

executable libri
    import:           warnings
    main-is:          Main.hs
    build-depends:    base
                    , libri
                    , text
                    , optparse-applicative
                    , directory >=1.3 && <2
    hs-source-dirs:   app
    default-language: GHC2021
    default-extensions: OverloadedStrings
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite libri-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:    TypesSpec
                    , SearchSpec
                    , BatchImportSpec
                    , CalibreImportSpec
                    , CalibreReconcileSpec
                    , YamlSpec
                    , NormalizeSpec
                    , CommandBarSpec
                    , GroupedListSpec
                    , EnrichSpec
                    , TagSidebarSpec
                    , TagsSpec
                    , DoctorSpec
                    , MigrateSpec
                    , AddBookSpec
                    , CommandsSpec
                    , CalibreSyncSpec
                    , CalibreImportDriverSpec
    build-depends:    base
                    , libri
                    , hspec >=2.10 && <3
                    , text
                    , containers
                    , time
                    , aeson
                    , unicode-transforms >=0.4 && <0.5
                    , temporary >=1.3 && <2
                    , filepath >=1.4 && <2
                    , directory >=1.3 && <2
                    , sqlite-simple >=0.4 && <0.5
    hs-source-dirs:   test
    default-language: GHC2021
    default-extensions: OverloadedStrings
